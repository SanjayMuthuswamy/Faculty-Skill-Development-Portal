# Faculty Skill Development Portal - Production env template
# Copy to .env and fill real values before `docker compose -f docker-compose.prod.yml up -d --build`

# -------- Container ports --------
APP_PORT=80

# -------- PostgreSQL --------
POSTGRES_DB=fsdp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password

# -------- Backend security (required) --------
# Generate secure values:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret

# -------- Backend runtime --------
ENVIRONMENT=production
DEBUG=false
ENABLE_API_DOCS=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
WEB_CONCURRENCY=2

# Set your real domain values for production.
CORS_ORIGINS=["https://your-domain.com"]
ALLOWED_HOSTS=["your-domain.com","www.your-domain.com"]

# -------- Frontend build --------
# Use "/" when frontend proxies /api to backend through nginx.
VITE_API_BASE_URL=/
# For Supabase Postgres, use this for backend deployments:
# DATABASE_URL=postgresql+asyncpg://postgres:<YOUR_SUPABASE_DB_PASSWORD>@db.gwdhvqtlrlvxwxnphrms.supabase.co:5432/postgres?ssl=require

# -------- Optional integrations --------
NEWSDATA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# -------- Optional demo users bootstrap --------
BOOTSTRAP_DEMO_USERS=false
DEMO_ADMIN_EMAIL=admin@fsdp.com
DEMO_ADMIN_PASSWORD=
DEMO_FACULTY_EMAIL=faculty@fsdp.com
DEMO_FACULTY_PASSWORD=
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
