# Faculty Skill Development Portal - Environment Configuration

# Application Settings
DEBUG=False  # Set to True only for development

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/fsdp_db

# JWT Configuration (REQUIRED - generate strong secrets)
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (adjust for your environment)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Optional: External APIs
NEWSDATA_API_KEY=your-newsdata-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: AI Configuration
OPENROUTER_MODEL=openrouter/auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Default test credentials (created during database initialization)
# Admin: admin@fsdp.com / Admin@123
# Faculty: faculty@fsdp.com / Faculty@123
